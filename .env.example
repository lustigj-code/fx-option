# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fxoption
DATABASE_PASSWORD=fxoption_dev
DATABASE_NAME=fxoption

# Redis Configuration
DATABASE_REDIS_HOST=localhost
DATABASE_REDIS_PORT=6379
DATABASE_REDIS_DB=0
DATABASE_REDIS_PASSWORD=

# Gateway Service
GATEWAY_DRY_RUN=true
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_STORAGE_DIR=./data/execution-orders

# Frontend Applications
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ADMIN_API_BASE_URL=http://localhost:8000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-generated-secret-min-32-chars-required

# QuickBooks Online
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8000/qbo/callback
QBO_REALM_ID=
QBO_WEBHOOK_VERIFIER_TOKEN=
QBO_ENVIRONMENT=sandbox
QBO_EXPOSURE_TOPIC=exposure.created
QBO_HTTP_TIMEOUT=2.5

# Interactive Brokers
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DLOCAL_API_KEY=
DLOCAL_SECRET_KEY=
WISE_API_KEY=
WISE_PROFILE_ID=

# Market Data
BANXICO_TOKEN=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars-required
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
